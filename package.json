{
  "name": "buf-action",
  "version": "1.4.0",
  "description": "GitHub Action for buf",
  "main": "src/main.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write 'src/*.{json,js,jsx,ts,tsx,css}' --log-level error",
    "lint": "eslint --max-warnings 0 src",
    "lint:fix": "eslint --max-warnings 0 --fix src",
    "build": "ncc build -o dist src/main.ts && ncc build -o dist/post src/post.ts"
  },
  "keywords": [
    "actions",
    "buf",
    "proto",
    "protobuf"
  ],
  "author": "step-security",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^24.3.0",
    "@types/semver": "^7.7.0",
    "@vercel/ncc": "^0.44.1",
    "eslint": "^10.0.3",
    "globals": "^16.3.0",
    "prettier": "3.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.33.0"
  },
  "dependencies": {
    "@actions/core": "^2.0.0",
    "@actions/exec": "^2.0.0",
    "@actions/github": "^9.0.0",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0",
    "@buf/bufbuild_registry.bufbuild_es": "^2.2.3-20250116203702-1c024d64352b.1",
    "@bufbuild/protobuf": "^2.2.5",
    "@connectrpc/connect": "^2.0.1",
    "@connectrpc/connect-web": "^2.0.1",
    "@octokit/webhooks-types": "^7.6.1",
    "axios": "^1.18.1",
    "parse-diff": "^0.11.1",
    "semver": "^7.7.2"
  }
}
